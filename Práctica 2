# Area de funciones
from IPython.core.prefilter import PrefilterHandler
import pandas as pd

def eliminar_duplicados(df):
    print(f"Cantidad de duplicados antes: {df.duplicated().sum()}")
    df = df.drop_duplicates()
    print(f"Cantidad de duplicados después: {df.duplicated().sum()}")
    return df 
 
def ajustar_fecha(df, columna_fecha):
    df[columna_fecha] = pd.to_datetime(df[columna_fecha])
    return df

def diagnostico(df):
    print("--- DIMENSIONES DEL DATASET ---")
    print(df.shape)

    print("--- TIPOS DE DATOS ---")
    print(df.dtypes)

def analisis(df):
    print("--- PRIMERAS 5 FILAS ---")
    head = df.head(6)
    print(head)

    print("--- RADIOGRAFIA TECNICA ---")
    df.info()

    print("--- ESTADISTICAS DESCRIPTIVAS ---")
    describir = df.describe()
    print(describir)

def nulos(df):
    nulos_df = df.isnull().sum()
    return nulos_df


# Importamos el archivo CSV desde el repositorio web (Github)
df = pd.read_csv("https://raw.githubusercontent.com/Lulitaax/Tratamiento-de-datos-3/refs/heads/main/practica_2.csv")


# Programa Principal

# Hago una copia
df_relleno = df.copy()

print("------- DIAGNOSTICO INICIAL ------")
diagnostico(df_relleno)


print("--------- AJUSTES ---------")

print("--- ELIMINO DATOS REPETIDOS ---")

# Eliminar duplicados
df_relleno = eliminar_duplicados(df_relleno)

print("--------- DF sin duplicados ---------")
print(df_relleno)


# Ajuste de fechas
df_relleno = ajustar_fecha(df_relleno, "Datetime")

print("--------- Columna Datetime cambiada a tiempo real ---------")
print(df_relleno)


# Analisis de variables
print("------ EDA ------")
analisis(df_relleno)


# Nulos
print("Nulos por columna:")
print(nulos(df_relleno))


# VERIFICACION FINAL
print(f"Cantidad de duplicados después: {df_relleno.duplicated().sum()}")
print(f"Tamaño final del dataset: {df_relleno.shape}")
